FROM node:22-alpine

WORKDIR /app

COPY packages/shared ./packages/shared
COPY backend/package.json backend/package-lock.json ./backend/
WORKDIR /app/backend
RUN npm ci
WORKDIR /app/packages/shared
RUN npx tsc
WORKDIR /app/backend

COPY backend ./

ENV NODE_ENV=development
ENV PORT=5000

EXPOSE 5000
CMD ["npm", "run", "dev"]
