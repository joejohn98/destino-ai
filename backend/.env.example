# Destino Backend — Environment Configuration Example

# Server
PORT=3000
NODE_ENV=development

# Client URL (for CORS and OAuth redirect)
CLIENT_URL=http://localhost:3000

# Database (MongoDB connection string)
DATABASE_URL=mongodb://localhost:27017/destino

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION=7d

# Caching (Redis)
REDIS_URL=redis://localhost:6379

# Reverse proxy hops or trusted proxy IP/CIDRs; leave false when directly exposed
TRUST_PROXY=false

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OAuth — Google (Optional in local development)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth — GitHub (Optional in local development)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

